# Copy to `.env` and fill in. Do NOT commit `.env`.

# --- App runtime -----------------------------------------------------------

# Database connection URL for Prisma.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/diy_inspector?schema=public

# Root folder for uploaded attachments (served via /api/uploads/:id).
UPLOADS_DIR=./uploads

# Backend HTTP port.
PORT=3000

# App-wide secret for encrypting stored third-party credentials at rest
# (provider API keys, tracking passwords) and for wrapping per-user data keys
# (multiuser mode). REQUIRED — the backend refuses to boot without it. Minimum
# 32 characters. Rotating it without re-encrypting invalidates every stored
# secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Secret for signing multiuser JWTs. Minimum 32 characters. When multiuser mode
# is enabled and this is unset/short, login and registration return 503.
JWT_SECRET=

# Public web entry port (nginx) that serves the SPA and proxies /api. The
# managed Cloudflare tunnel targets THIS port so phone-facing SPA routes
# (/capture/:token) resolve to index.html, not an API 404. Default 8080.
# PUBLIC_WEB_PORT=8080

# Absolute public base URL used to build phone-facing links (QR capture URLs,
# and any future absolute links). See docs/tls-public-access.md.
#
# Leave UNSET when using an ephemeral tunnel (e.g. Cloudflare Quick Tunnel):
# the backend derives the base URL per-request from X-Forwarded-Proto /
# X-Forwarded-Host. Set it to a fixed origin (no trailing slash) for a stable
# named tunnel or hostname, e.g. https://mk.example.com
# PUBLIC_BASE_URL=

# --- Production stack (deploy/docker-compose.prod.yml) ---------------------
# The self-host container stack uses ITS OWN .env (generated by deploy/install.sh),
# not this file. See INSTALL.md for the full reference. Variables specific to that
# stack (in addition to APP_SECRET / JWT_SECRET / PUBLIC_BASE_URL above):
#   POSTGRES_USER, POSTGRES_DB, POSTGRES_PASSWORD  — bundled Postgres (build DATABASE_URL)
#   PUBLIC_WEB_PORT                                — host port for the web UI (default 8080)
#   TAG                                            — image version (pin vX.Y.Z in prod)
#   IMAGE_APP, IMAGE_WEB                           — ghcr image references
#   RUN_SEED                                       — 1 = run optional demo seed once
# In the stack DATABASE_URL is built from the POSTGRES_* vars; set it directly
# only when pointing at an EXTERNAL database.

# --- Tooling (dev agent / tracker; not app config) -------------------------

# Base URL of the Forgejo instance hosting the tracker, no trailing slash, and
# the <owner>/<repo> path on it. Optional; not read by the app. See CLAUDE.md §9.
FORGEJO_BASE_URL=
FORGEJO_REPO=

# Forgejo API token for tracker interaction. Optional; not read by the app.
FORGEJO_TOKEN=
